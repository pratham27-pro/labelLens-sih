# NeonDB PostgreSQL (pooler + direct for Prisma)
DATABASE_URL=""
DIRECT_URL=""

# Cloudinary CDN Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Internal FastAPI Compute Host
FASTAPI_URL=http://127.0.0.1:8000

# Label-mask scan pipeline (SAM2 unwrap → per-face OCR → compliance).
# OFF (default): photo scans run the direct-OCR pipeline, video uploads return 503.
# ON:  image and video uploads are routed through FastAPI POST /api/v1/video/unwrap first.
#      Requires the FastAPI server with its SAM2 checkpoint:
#        cd server && python scripts/download_checkpoint.py
#
# Two ways to toggle (CLI wins over env):
#   npm start -- --mask-scan     (enable)
#   npm start -- --no-mask-scan  (disable, overrides env)
ENABLE_MASK_SCAN=false

# Logging: warn | info | debug
LOG_LEVEL=warn
