# Default SQLite Database for Development
DATABASE_URL=sqlite:///./label_lens.db

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Direct LLM Compliance Evaluator (Groq / Qwen)
# Obtain a free API key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen-2.5-32b
LLM_BACKEND=groq

# PostgreSQL Configuration for Staging/Production:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/labellens
